package accessnyc.rules;
import accessnyc.response.EligibleProgram

import accessnyc.request.Person
import accessnyc.request.Household
import accessnyc.rules.income.IncomeHouseholdTotalMonthly
import accessnyc.rules.expense.ExpenseHouseholdHasHeating


rule "s2_r019"
    dialect "mvel"
    
    when 
        (
            IncomeHouseholdHasCashAssistance( value == true )
            or (Household(members == 1) and IncomeHouseholdHasSSI( value == true ))
            or (Household(members == 1) and IncomeHouseholdTotalMonthly(amount <= 3563))
            or (Household(members == 2) and IncomeHouseholdTotalMonthly(amount <= 4659))
            or (Household(members == 3) and IncomeHouseholdTotalMonthly(amount <= 5756))
            or (Household(members == 4) and IncomeHouseholdTotalMonthly(amount <= 6852))
            or (Household(members == 5) and IncomeHouseholdTotalMonthly(amount <= 7948))
            or (Household(members == 6) and IncomeHouseholdTotalMonthly(amount <= 9045))
            or (Household(members == 7) and IncomeHouseholdTotalMonthly(amount <= 9250))
            or (Household(members == 8) and IncomeHouseholdTotalMonthly(amount <= 9456))
        )

    then
        $programcode = new EligibleProgram()
        $programcode.setCode("S2R019")
        insertLogical($programcode)

end